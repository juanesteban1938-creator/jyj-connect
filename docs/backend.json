
{
  "entities": {
    "Driver": {
      "title": "Driver",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombres": { "type": "string" },
        "apellidos": { "type": "string" },
        "cedula": { "type": "string" },
        "telefono": { "type": "string" },
        "categoriaLicencia": { "type": "string" },
        "vencimientoLicencia": { "type": "string", "format": "date-time" }
      }
    },
    "Vehicle": {
      "title": "Vehicle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "placa": { "type": "string" },
        "marca": { "type": "string" },
        "linea": { "type": "string" },
        "modelo": { "type": "string" },
        "capacidad": { "type": "number" }
      }
    },
    "Service": {
      "title": "Service",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "consecutivo": { "type": "string" },
        "cliente": { "type": "string" },
        "origen": { "type": "string" },
        "destino": { "type": "string" },
        "fecha": { "type": "string", "format": "date-time" },
        "estado": { "type": "string", "enum": ["Programado", "En Servicio", "Finalizado", "Cancelado"] },
        "valorServicio": { "type": "number" },
        "saldo": { "type": "number" }
      }
    },
    "Envio": {
      "title": "Envio Custodia",
      "type": "object",
      "description": "Registro de envío blindado con cálculo de riesgo.",
      "properties": {
        "id": { "type": "string" },
        "consecutivo": { "type": "string" },
        "origen": { "type": "string" },
        "destino": { "type": "string" },
        "valorDeclarado": { "type": "number" },
        "tarifaTotal": { "type": "number" },
        "estado": { "type": "string", "enum": ["Programado", "En Ruta", "Entregado", "Cancelado"] }
      }
    },
    "UsuarioPanel": {
      "title": "Usuario Panel",
      "type": "object",
      "description": "Perfil de usuario con permisos basados en módulos.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "nombre": { "type": "string" },
        "rol": { "type": "string", "enum": ["admin", "operador"] },
        "modulos_permitidos": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ConfigCustodia": {
      "title": "Configuración Custodia",
      "type": "object",
      "description": "Parámetros financieros para el módulo de envíos blindados.",
      "properties": {
        "costo_fijo_mensual": { "type": "number" },
        "tasa_riesgo": { "type": "number" },
        "tope_cobertura_estandar": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/adminUsers/{userId}": {
      "schema": "AdminRole",
      "description": "Usuarios con privilegios de administrador."
    },
    "/conductores/{id}": {
      "schema": "Driver",
      "description": "Base de datos de conductores de la flota."
    },
    "/vehiculos/{id}": {
      "schema": "Vehicle",
      "description": "Inventario de vehículos de la empresa."
    },
    "/services/{id}": {
      "schema": "Service",
      "description": "Registro principal de operaciones de transporte."
    },
    "/envios/{id}": {
      "schema": "Envio",
      "description": "Registro de envíos blindados de J&J Custodia."
    },
    "/usuarios_panel/{id}": {
      "schema": "UsuarioPanel",
      "description": "Gestión de roles y permisos de acceso al panel."
    },
    "/configuracion_custodia/{id}": {
      "schema": "ConfigCustodia",
      "description": "Configuración global de parámetros para J&J Custodia."
    }
  }
}
