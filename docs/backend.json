{
  "entities": {
    "Driver": {
      "title": "Driver",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombres": { "type": "string" },
        "apellidos": { "type": "string" },
        "cedula": { "type": "string" },
        "telefono": { "type": "string" },
        "vencimientoLicencia": { "type": "string", "format": "date-time" }
      }
    },
    "Vehicle": {
      "title": "Vehicle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "placa": { "type": "string" },
        "marca": { "type": "string" },
        "modelo": { "type": "string" },
        "vencimientoSoat": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      { "path": "/admins/{id}", "description": "Admin users list" },
      { "path": "/conductores/{id}", "description": "Fleet drivers" },
      { "path": "/vehiculos/{id}", "description": "Fleet vehicles" },
      { "path": "/clientes/{id}", "description": "Client database" },
      { "path": "/services/{id}", "description": "Transportation services" },
      { "path": "/transacciones/{id}", "description": "Financial records" },
      { "path": "/cotizaciones/{id}", "description": "WhatsApp quotes" },
      { "path": "/conversaciones/{id}", "description": "Chat history" }
    ]
  }
}