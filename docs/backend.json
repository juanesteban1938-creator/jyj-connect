
{
  "entities": {
    "Cliente": {
      "title": "Cliente",
      "description": "Entidad que representa a un cliente de la empresa.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "nit": { "type": "string" },
        "direccion": { "type": "string" },
        "telefono": { "type": "string" },
        "ciudad": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      }
    },
    "CuentaCobro": {
      "title": "CuentaCobro",
      "description": "Entidad que representa una cuenta de cobro emitida.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "numero": { "type": "string" },
        "fecha": { "type": "string", "format": "date-time" },
        "clienteId": { "type": "string" },
        "totalGeneral": { "type": "number" },
        "estado": { "type": "string", "enum": ["pendiente", "enviada", "pagada"] }
      }
    },
    "Servicio": {
      "title": "Servicio",
      "description": "Entidad que representa un servicio de transporte programado.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "consecutivo": { "type": "string" },
        "cliente": { "type": "string" },
        "nitCliente": { "type": "string" },
        "telefonoCliente": { "type": "string" },
        "origen": { "type": "string" },
        "destino": { "type": "string" },
        "hora": { "type": "string" },
        "fecha": { "type": "string" },
        "conductor": { "type": "string" },
        "vehiculo": { "type": "string" },
        "vehiculoPlaca": { "type": "string" },
        "estado": { "type": "string" },
        "notificacionSalidaEnviada": { "type": "boolean" },
        "horaRecogidaTimestamp": { "type": "string", "format": "date-time" }
      }
    },
    "NotificacionWhatsapp": {
      "title": "NotificacionWhatsapp",
      "description": "Registro de intentos de envío de notificaciones vía WhatsApp.",
      "type": "object",
      "properties": {
        "fecha": { "type": "string", "format": "date-time" },
        "clienteNombre": { "type": "string" },
        "clienteTelefono": { "type": "string" },
        "origen": { "type": "string" },
        "destino": { "type": "string" },
        "estado": { "type": "string", "enum": ["enviado", "error"] },
        "error": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/clientes/{clienteId}": {
      "schema": { "$ref": "#/backend/entities/Cliente" },
      "description": "Colección de clientes."
    },
    "/cuentas_cobro/{cuentaCobroId}": {
      "schema": { "$ref": "#/backend/entities/CuentaCobro" },
      "description": "Colección de cuentas de cobro."
    },
    "/servicios/{servicioId}": {
      "schema": { "$ref": "#/backend/entities/Servicio" },
      "description": "Colección de servicios para el bot."
    },
    "/notificaciones_whatsapp/{notificacionId}": {
      "schema": { "$ref": "#/backend/entities/NotificacionWhatsapp" },
      "description": "Historial de notificaciones de WhatsApp."
    }
  }
}
