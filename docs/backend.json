
{
  "entities": {
    "Driver": {
      "title": "Driver",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombres": { "type": "string" },
        "apellidos": { "type": "string" },
        "cedula": { "type": "string" },
        "telefono": { "type": "string" },
        "categoriaLicencia": { "type": "string" },
        "vencimientoLicencia": { "type": "string", "format": "date-time" }
      }
    },
    "Vehicle": {
      "title": "Vehicle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "placa": { "type": "string" },
        "marca": { "type": "string" },
        "linea": { "type": "string" },
        "modelo": { "type": "string" },
        "capacidad": { "type": "number" }
      }
    },
    "Service": {
      "title": "Service",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "consecutivo": { "type": "string" },
        "cliente": { "type": "string" },
        "origen": { "type": "string" },
        "destino": { "type": "string" },
        "fecha": { "type": "string", "format": "date-time" },
        "estado": { "type": "string", "enum": ["Programado", "En Servicio", "Finalizado", "Cancelado"] },
        "valorServicio": { "type": "number" },
        "saldo": { "type": "number" }
      }
    },
    "AsientoContable": {
      "title": "Asiento Contable",
      "type": "object",
      "description": "Registro de partida doble para trazabilidad financiera inmutable.",
      "properties": {
        "fecha": { "type": "string", "format": "date-time" },
        "concepto": { "type": "string" },
        "sourceId": { "type": "string" },
        "sourceModule": { "type": "string", "enum": ["services", "rentabilidad", "pagos"] },
        "totalDebito": { "type": "number" },
        "totalCredito": { "type": "number" },
        "movimientos": { "type": "array" }
      }
    },
    "CierreFiscal": {
      "title": "Cierre Fiscal",
      "type": "object",
      "description": "Punto de control que bloquea alteraciones en periodos contables cerrados.",
      "properties": {
        "mes": { "type": "number" },
        "anio": { "type": "number" },
        "fechaCierre": { "type": "string", "format": "date-time" },
        "cerradoPor": { "type": "string" }
      }
    },
    "UsuarioPanel": {
      "title": "Usuario Panel",
      "type": "object",
      "description": "Perfil de usuario con permisos basados en módulos.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "nombre": { "type": "string" },
        "rol": { "type": "string", "enum": ["admin", "operador"] },
        "modulos_permitidos": { "type": "array", "items": { "type": "string" } },
        "fecha_creacion": { "type": "string", "format": "date-time" }
      }
    },
    "ConfigCustodia": {
      "title": "Configuración Custodia",
      "type": "object",
      "description": "Parámetros financieros para el módulo de envíos blindados.",
      "properties": {
        "costo_fijo_mensual": { "type": "number" },
        "envios_mes_estimados": { "type": "number" },
        "tarifa_por_km": { "type": "number" },
        "cargo_fijo_custodia": { "type": "number" },
        "tasa_riesgo": { "type": "number" },
        "margen_utilidad": { "type": "number" },
        "tope_cobertura_estandar": { "type": "number" },
        "valor_declarado_minimo": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/adminUsers/{userId}": {
      "schema": "AdminRole",
      "description": "Usuarios con privilegios de administrador."
    },
    "/conductores/{id}": {
      "schema": "Driver",
      "description": "Base de datos de conductores de la flota."
    },
    "/vehiculos/{id}": {
      "schema": "Vehicle",
      "description": "Inventario de vehículos de la empresa."
    },
    "/clientes/{id}": {
      "schema": "Customer",
      "description": "Cartera de clientes corporativos e individuales."
    },
    "/services/{id}": {
      "schema": "Service",
      "description": "Registro principal de operaciones de transporte."
    },
    "/asientos_contables/{id}": {
      "schema": "AsientoContable",
      "description": "Libro mayor inmutable de la empresa."
    },
    "/cierres_fiscales/{id}": {
      "schema": "CierreFiscal",
      "description": "Historial de bloqueos de periodos fiscales."
    },
    "/usuarios_panel/{id}": {
      "schema": "UsuarioPanel",
      "description": "Gestión de roles y permisos de acceso al panel."
    },
    "/configuracion_custodia/{id}": {
      "schema": "ConfigCustodia",
      "description": "Configuración global de parámetros para J&J Custodia."
    }
  }
}
