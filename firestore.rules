rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * TRANSPORTES ESPECIALES J&J - SECURITY RULES (V2.2)
     *
     * CORE PHILOSOPHY:
     * Full administrative access for the master account and registered admins.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    /** 
     * @description Checks if user is admin. 
     * Prioritizes the master email to ensure access even if the database is uninitialized.
     */
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'transportes.especialesjyj@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Global Admin Rule ---
    // This ensures any collection (services, conductores, vehiculos, etc.) is accessible to admins.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- Specific Overrides ---
    match /admins/{adminId} {
      // Allow any signed-in user to 'get' their own potential admin doc to check status
      allow get: if isSignedIn();
    }

    // Nova Session Handling (Internal)
    match /sesiones_nova/{id} {
      allow read, write: if isAdmin();
    }
  }
}