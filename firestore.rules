rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * TRANSPORTES ESPECIALES J&J - SECURITY RULES (V2.1)
     *
     * CORE PHILOSOPHY:
     * Enforces administrative access based on the /admins collection and the master email.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if user is admin via collection or master email. */
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'transportes.especialesjyj@gmail.com'
      );
    }

    function isExistingAdmin() {
      return isAdmin() && resource != null;
    }

    // --- Collection Rules ---

    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list, write: if isAdmin();
    }

    // Personal Operativo
    match /conductores/{id} {
      allow read, write: if isAdmin();
    }

    // Flota
    match /vehiculos/{id} {
      allow read, write: if isAdmin();
    }

    // Cartera
    match /clientes/{id} {
      allow read, write: if isAdmin();
    }

    // Operaciones
    match /services/{id} {
      allow read, write: if isAdmin();
    }

    // P&G
    match /transacciones/{id} {
      allow read, write: if isAdmin();
    }

    // Sistema Nova & WhatsApp
    match /cotizaciones/{id} {
      allow read, write: if isAdmin();
    }

    match /conversaciones/{id} {
      allow read, write: if isAdmin();
    }

    match /notificaciones_whatsapp/{id} {
      allow read, write: if isAdmin();
    }
    
    match /sesiones_nova/{id} {
      allow read, write: if isAdmin();
    }

    // Compatibilidad Invoices
    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
      match /payments/{paymentId} {
        allow read, write: if isAdmin();
      }
    }
  }
}