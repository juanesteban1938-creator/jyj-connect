
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'transportes.especialesjyj@gmail.com' ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }

    /** @description Acceso Total Administrador */
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    /** @description Perfiles de Usuario (Lectura básica para sesión) */
    match /usuarios_panel/{userId} {
      allow get: if isSignedIn();
      allow list, write: if isAdmin();
    }

    /** @description Envíos y Servicios (Públicos para Trackers) */
    match /envios/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /services/{serviceId} {
      allow get: if true;
      allow read, write: if isAdmin();
    }

    match /ubicaciones_gps/{serviceId} {
      allow get, list: if isAdmin();
      allow write: if true; 
    }
    
    match /conversaciones/{id} {
      allow read, write: if isAdmin();
    }
    
    match /notificaciones_whatsapp/{id} {
      allow read: if isAdmin();
      allow write: if true;
    }
  }
}
