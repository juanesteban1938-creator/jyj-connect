rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * J&J CONNECT V2.0 - PRODUCTION RULES
     * Sincronización forzada para: jj-connect--18988325-5ab9e
     */
    match /{document=**} {
      // Permitir acceso total a cualquier usuario autenticado (incluyendo anónimos)
      // Esto soluciona el error de "Missing or insufficient permissions"
      allow read, write: if request.auth != null;
    }
  }
}