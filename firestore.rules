
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * VIANOVA S.A.S. - TRANSPORT MANAGEMENT SYSTEM
     * SECURITY RULES - v2.2 (Added Notification Logs)
     */

    function isSignedIn() {
      return request.auth != null;
    }

    /** 
     * @description Historial de notificaciones de WhatsApp. 
     * Acceso abierto para lectura y creación para permitir el monitoreo de Nova.
     */
    match /notificaciones_whatsapp/{notificacionId} {
      allow read, create: if true;
    }

    /** @description Colección de clientes. */
    match /clientes/{clienteId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    /** @description Colección de cuentas de cobro. */
    match /cuentas_cobro/{cuentaCobroId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    /** @description Gestión de roles administrativos. */
    match /roles_admin/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if isSignedIn();
      allow write: if false;
    }

    // Regla por defecto: denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
