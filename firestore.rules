rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * J&J CONNECT V2.0 - SECURITY RULES
     * Proyecto: jj-connect--18988325-5ab9e
     * Reglas simplificadas para garantizar acceso a usuarios autenticados.
     */
    match /{document=**} {
      // Permite lectura y escritura a cualquier usuario con sesión (incluyendo anónimos)
      allow read, write: if request.auth != null;
    }
  }
}