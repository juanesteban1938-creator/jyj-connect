rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * J&J CONNECT V2.0 - SECURITY RULES
     * PROD SYNC: 2026-03-07 (Deployment Verification)
     * Proyecto: jj-connect--18988325-5ab9e
     */

    match /{document=**} {
      // Permite lectura y escritura a cualquier usuario autenticado (incluyendo anónimos)
      allow read, write: if request.auth != null;
    }
    
    // Reglas específicas para colecciones principales
    match /services/{serviceId} {
      allow read, write: if request.auth != null;
    }
    
    match /clientes/{clienteId} {
      allow read, write: if request.auth != null;
    }
    
    match /notificaciones_whatsapp/{notifId} {
      allow read, write: if request.auth != null;
    }
  }
}
