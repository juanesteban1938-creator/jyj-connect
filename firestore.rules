rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * VIANOVA S.A.S. - TRANSPORT MANAGEMENT SYSTEM
     * SECURITY RULES PHILOSOPHY:
     * 1. ADMINISTRATIVE CONTROL: This system operates on a central administrative model.
     * 2. DATABASE-BACKED AUTHORIZATION (DBAC): User roles are managed via a dedicated 
     *    '/roles_admin' collection.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isExistingAdmin() {
      return isAdmin() && resource != null;
    }

    // --- COLLECTION RULES ---

    /** @description Colección de clientes. Accesible por admins o usuarios autenticados para el prototipo. */
    match /clientes/{clienteId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    /** @description Colección de cuentas de cobro. Accesible por admins o usuarios autenticados para el prototipo. */
    match /cuentas_cobro/{cuentaCobroId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    /** @description Historial de notificaciones de WhatsApp. Permite lectura y creación de logs. */
    match /notificaciones_whatsapp/{notificacionId} {
      allow read, create: if true;
    }

    /** @description Gestión de roles administrativos. */
    match /roles_admin/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow write: if false;
    }
  }
}