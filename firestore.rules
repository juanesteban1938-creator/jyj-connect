rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * J&J CONNECT V2.0 - SECURITY RULES
     * PROD SYNC: 2026-03-06 (Forced Deployment)
     * Proyecto: jj-connect--18988325-5ab9e
     */

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
