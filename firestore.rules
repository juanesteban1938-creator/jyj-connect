rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Transportes Especiales J&J - Reglas de Seguridad V2.5
     * 
     * Core Philosophy: Control de acceso basado en roles administrativos y 
     * acceso público limitado para funciones de rastreo y servicios externos.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    function isExistingAdmin() {
      return isAdmin() && resource != null;
    }

    // --- Collection Rules ---

    /** @description Identificación de administradores. */
    match /adminUsers/{userId} {
      allow get: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow list, create, update, delete: if isAdmin();
    }

    /** @description Gestión de conductores y personal. */
    match /conductores/{id} { allow read, write: if isAdmin(); }
    match /drivers/{id} { allow read, write: if isAdmin(); }

    /** @description Gestión de flota de vehículos. */
    match /vehiculos/{id} { allow read, write: if isAdmin(); }
    match /vehicles/{id} { allow read, write: if isAdmin(); }

    /** @description Base de datos de clientes. */
    match /clientes/{id} { allow read, write: if isAdmin(); }
    match /customers/{id} { allow read, write: if isAdmin(); }

    /** @description Programación de servicios y logística. */
    match /services/{serviceId} {
      allow read, write: if isAdmin();
      allow get: if true; // Necesario para que la página de GPS pública vea el destino/conductor
    }

    /** @description Solicitudes Nova y Cotizaciones. */
    match /cotizaciones/{id} { allow read, write: if isAdmin(); }
    match /solicitudes_asesor/{id} { allow read, write: if isAdmin(); }

    /** @description Auditoría financiera y recaudos. */
    match /pagos_aplicados/{id} { allow read, write: if isAdmin(); }
    match /pagos_pendientes_correo/{id} { allow read, write: if isAdmin(); }
    match /transacciones/{id} { allow read, write: if isAdmin(); }
    match /invoices/{id} { allow read, write: if isAdmin(); }
    match /expenses/{id} { allow read, write: if isAdmin(); }

    /** @description Monitoreo GPS en tiempo real. */
    match /ubicaciones_gps/{serviceId} {
      allow get, list: if isAdmin();
      allow write: if true; // Permite a conductores externos transmitir sin auth
    }

    /** @description Mensajería y Automatización Nova. */
    match /conversaciones/{id} { allow read, write: if isAdmin(); }
    match /sesiones_nova/{id} { allow read, write: if isAdmin(); }
    match /notificaciones_whatsapp/{id} { allow read, write: if isAdmin(); }

    /** @description Seguimiento público denormalizado. */
    match /publicServiceTracking/{serviceId} {
      allow get: if (resource != null && resource.data.isPubliclyTrackable == true) || isAdmin();
      allow list, write: if isAdmin();
    }
  }
}